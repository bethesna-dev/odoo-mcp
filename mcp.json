{
  "mcpServers": {
    "odoo": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/bethesna-dev/odoo-mcp", "odoo-mcp"],
      "env": {
        "ODOO_URL": "${env:ODOO_URL}",
        "ODOO_DB": "${env:ODOO_DB}",
        "ODOO_USERNAME": "${env:ODOO_USERNAME}",
        "ODOO_API_KEY": "${env:ODOO_API_KEY}",
        "ODOO_ALLOW_WRITES": "${env:ODOO_ALLOW_WRITES}"
      }
    }
  }
}
